# Credentials — NEVER commit
.env
.env.*

# Per-machine MCP / agent / IDE configs (regenerated by `tessl init` and IDE setup)
.mcp.json
.gemini/
.codex/
.vscode/
.tessl/
.claude/
.agents/

# Files that tessl install creates (re-created live on stage during the Stage 3 install beat).
# Keep these gitignored so a fresh clone has zero pre-loaded plugin context, and the
# `tessl install` beat shows real creation, not just an update.
AGENTS.md
CLAUDE.md

# Gradle + Kotlin build outputs
**/build/
**/.gradle/
**/.kotlin/
**/out/

# JetBrains IDE
.idea/
*.iml

# macOS
.DS_Store

# Logs / scratch
*.log
# === Tessl-generated artifacts (managed by jbaruch/coding-policy) ===
# Regenerated by `tessl install` (analogous to node_modules). Only tessl.json
# (the manifest) is committed; everything below is per-developer / per-agent
# output. Shared dirs (.github, .vscode) keep everything else — only tessl's own
# paths are listed here.
.tessl/
.agents/
.mcp.json
.claude/settings.json
.claude/skills/tessl__*
.codex/config.toml
.codex/skills/tessl__*
.gemini/settings.json
.cursor/mcp.json
.cursor/hooks.json
.cursor/rules/tessl__*
.cursor/skills/tessl__*
.openhands/hooks.json
.openhands/skills/tessl-*
.github/mcp.json
.github/hooks/tessl.json
.github/skills/tessl__*
.vscode/mcp.json
.vscode/skills/tessl__*
# === end Tessl-generated artifacts ===
